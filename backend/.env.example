SECRET_KEY=your-secret-key
DEBUG=True

DB_NAME=motoparts_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback/
MPESA_ENVIRONMENT=sandbox

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Delivery fees. Leave DELIVERY_FEES_JSON unset to use the built-in defaults in
# config/settings.py. County names are matched case-insensitively; any county
# not listed falls back to DEFAULT_DELIVERY_FEE.
# DELIVERY_FEES_JSON={"Mombasa":200,"Nairobi":300,"Kisumu":350,"Eldoret":350,"Nakuru":300,"Kiambu":300,"Machakos":350}
DEFAULT_DELIVERY_FEE=500

USE_SQLITE=True
